# Скопируй в .env и поправь под себя — Fretlines прочитает при запуске.

# 0.0.0.0 — открыть приложение для телефонов и планшетов в твоей сети (для репетиций группой).
FRETLINES_HOST=127.0.0.1
FRETLINES_PORT=8080

# auto — видеокарта NVIDIA, если стоит PyTorch с CUDA (см. gpu.bat), иначе процессор.
FRETLINES_DEVICE=auto

# Лимит загрузки аудио, МБ (для видеофайлов — FRETLINES_MAX_VIDEO_UPLOAD_MB, по умолчанию 200).
FRETLINES_MAX_UPLOAD_MB=50
